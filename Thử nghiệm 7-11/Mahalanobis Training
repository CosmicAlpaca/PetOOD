 Recall F1-score  Số bản ghi\n","0       In-Distribution (ID)    82.33%  93.98%   87.77%        3669\n","1  Out-of-Distribution (OOD)    99.31%  97.72%   98.51%       32432\n","2     Trung bình (Macro Avg)    90.82%  95.85%   93.14%       36101\n","3   Bình quân (Weighted Avg)    97.58%  97.34%   97.42%       36101\n","4    Độ chính xác (Accuracy)         -       -   97.34%       36101"]},"metadata":{},"output_type":"display_data"}],"source":["# ==============================================================================\n","# 1. CÀI ĐẶT & CHUẨN BỊ DỮ LIỆU\n","# ==============================================================================\n","print(\">>> BƯỚC 1: CÀI ĐẶT & TẢI DỮ LIỆU... (Vui lòng chờ)\")\n","!pip install -q pandas scikit-learn torchmetrics\n","\n","import os\n","import torch\n","import torch.nn as nn\n","import torch.optim as optim\n","import torchvision\n","import torchvision.models as models\n","import torchvision.transforms as transforms\n","from torch.utils.data import DataLoader, random_split, Subset\n","from tqdm.notebook import tqdm\n","import numpy as np\n","import pandas as pd\n","from sklearn.metrics import classification_report\n","\n","# Cấu hình\n","torch.manual_seed(42); np.random.seed(42)\n","DEVICE = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n","\n","# Transforms\n","transform = transforms.Compose([\n","    transforms.Grayscale(num_output_channels=3),\n","    transforms.Resize(256),\n","    transforms.CenterCrop(224),\n","    transforms.ToTensor(),\n","    transforms.Normalize([0.485, 0.456, 0.406], [0.229, 0.224, 0.225])\n","])\n","\n","# Tải Datasets\n","# 1. ID: Oxford Pets\n","id_data = torchvision.datasets.OxfordIIITPet(root='./data', split='trainval', download=True, transform=transform)\n","train_size = int(0.9 * len(id_data)); val_size = len(id_data) - train_size\n","id_train, id_val = random_split(id_data, [train_size, val_size])\n","\n","id_test = torchvision.datasets.OxfordIIITPet(root='./data', split='test', download=True, transform=transform)\n","num_classes = len(id_data.classes)\n","\n","# 2. OOD: STL-10 & SVHN\n","ood_stl = torchvision.datasets.STL10(root='./data', split='test', download=True, transform=transform)\n","# Lọc bỏ chó/mèo trong STL-10\n","idx_stl = [i for i, label in enumerate(ood_stl.labels) if label not in [3, 5]]\n","ood_stl = Subset(ood_stl, idx_stl)\n","\n","ood_svhn = torchvision.datasets.SVHN(root='./data', split='test', download=True, transform=transform)\n","\n","# Loaders\n","train_loader = DataLoader(id_train, batch_size=32, shuffle=True, num_workers=2)\n","val_loader = DataLoader(id_val, batch_size=32, shuffle=False, num_workers=2)\n","test_loader_id = DataLoader(id_test, batch_size=32, shuffle=False, num_workers=2)\n","test_loader_near = DataLoader(ood_stl, batch_size=32, shuffle=False, num_workers=2)\n","test_loader_far = DataLoader(ood_svhn, batch_size=32, shuffle=False, num_workers=2)\n","\n","# ==============================================================================\n","# 2. ĐỊNH NGHĨA MODEL & HUẤN LUYỆN (CROSS-ENTROPY)\n","# ==============================================================================\n","print(\"\\n>>> BƯỚC 2: HUẤN LUYỆN MODEL (Feature Extractor)...\")\n","\n","class ResNetFeatureExtractor(nn.Module):\n","    def __init__(self, num_classes):\n","        super().__init__()\n","        self.backbone = models.resnet18(weights=models.ResNet18_Weights.DEFAULT)\n","        self.feature_dim = self.backbone.fc.in_features\n","        self.backbone.fc = nn.Linear(self.feature_dim, num_classes)\n","\n","    def forward(self, x, return_feature=False):\n","        # Trích xuất feature từ lớp avgpool\n","        x = self.backbone.conv1(x)\n","        x = self.backbone.bn1(x)\n","        x = self.backbone.relu(x)\n","        x = self.backbone.maxpool(x)\n","        x = self.backbone.layer1(x)\n","        x = self.backbone.layer2(x)\n","        x = self.backbone.layer3(x)\n","        x = self.backbone.layer4(x)\n","        x = self.backbone.avgpool(x)\n","        feature = torch.flatten(x, 1)\n","        logits = self.backbone.fc(feature)\n","        if return_feature: return logits, feature\n","        return logits\n","\n","model = ResNetFeatureExtractor(num_classes).to(DEVICE)\n","optimizer = optim.Adam(model.parameters(), lr=1e-4)\n","criterion = nn.CrossEntropyLoss()\n","\n","# Training Loop ngắn gọn (5 Epochs để demo nhanh, thực tế nên train lâu hơn)\n","for epoch in range(5):\n","    model.train()\n","    total_loss = 0\n","    for x, y in tqdm(train_loader, desc=f\"Epoch {epoch+1}/5\", leave=False):\n","        x, y = x.to(DEVICE), y.to(DEVICE)\n","        optimizer.zero_grad()\n","        out = model(x)\n","        loss = criterion(out, y)\n","        loss.backward()\n","        optimizer.step()\n","        total_loss += loss.item()\n","    print(f\"Epoch {epoch+1}: Loss = {total_loss/len(train_loader):.4f}\")\n","\n","# ==============================================================================\n","# 3. TÍNH THAM SỐ MAHALANOBIS (MEAN & COVARIANCE)\n","# ==============================================================================\n","print(\"\\n>>> BƯỚC 3: TÍNH TOÁN MAHALANOBIS PARAMETERS...\")\n","\n","def compute_params(model, loader):\n","    model.eval()\n","    feats, lbls = [], []\n","    with torch.no_grad():\n","        for x, y in tqdm(loader, desc=\"Extracting\"):\n","            _, f = model(x.to(DEVICE), return_feature=True)\n","            feats.append(f.cpu()); lbls.append(y)\n","    feats = torch.cat(feats); lbls = torch.cat(lbls)\n","\n","    # Tính Mean & Covariance\n","    means = []\n","    cov = torch.zeros(feats.size(1), feats.size(1))\n","    for c in range(num_classes):\n","        c_feats = feats[lbls == c]\n","        if len(c_feats) > 0:\n","            mean = c_feats.mean(0)\n","            zero_f = c_feats - mean\n","            cov += (zero_f.T @ zero_f)\n","        else:\n","            mean = torch.zeros(feats.size(1))\n","        means.append(mean)\n","\n","    means = torch.stack(means).to(DEVICE)\n","    # Nghịch đảo Covariance (Precision Matrix)\n","    cov = cov / len(feats)\n","    cov += torch.eye(cov.size(0)) * 1e-4 # Epsilon\n","    prec = torch.inverse(cov).to(DEVICE)\n","    return means, prec\n","\n","# Dùng tập train để tính tham số thống kê\n","loader_stats = DataLoader(id_train, batch_size=32, shuffle=False)\n","class_means, precision_matrix = compute_params(model, loader_stats)\n","\n","# ==============================================================================\n","# 4. TÍNH ĐIỂM VÀ TẠO BẢNG ĐÁNH GIÁ\n","# ==============================================================================\n","print(\"\\n>>> BƯỚC 4: ĐÁNH GIÁ & TẠO BẢNG KẾT QUẢ...\")\n","\n","def get_scores(model, loader):\n","    model.eval()\n","    scores = []\n","    with torch.no_grad():\n","        for x, _ in tqdm(loader, leave=False):\n","            _, f = model(x.to(DEVICE), return_feature=True)\n","            # Mahalanobis distance calculation\n","            batch_scores = []\n","            for c in range(num_classes):\n","                mean = class_means[c]\n","                zero_f = f - mean.unsqueeze(0)\n","                term = torch.matmul(zero_f, precision_matrix)\n","                dist = torch.sum(term * zero_f, dim=1)\n","                batch_scores.append(dist)\n","            # Lấy min distance tới class gần nhất\n","            min_dist, _ = torch.min(torch.stack(batch_scores, 1), 1)\n","            scores.extend(min_dist.cpu().numpy())\n","    return np.array(scores)\n","\n","# 1. Tính điểm cho các tập\n","val_scores = get_scores(model, val_loader)\n","id_test_scores = get_scores(model, test_loader_id)\n","near_ood_scores = get_scores(model, test_loader_near)\n","far_ood_scores = get_scores(model, test_loader_far)\n","\n","# 2. Xác định ngưỡng (Threshold)\n","# Ngưỡng sao cho 95% dữ liệu ID Validation được nhận diện đúng (True Positive Rate = 95%)\n","# Vì Mahalanobis score càng nhỏ càng tốt, nên Threshold là giá trị phân vị thứ 95\n","threshold = np.percentile(val_scores, 95)\n","print(f\"Ngưỡng Mahalanobis (95% TPR): {threshold:.4f}\")\n","\n","# 3. Tạo nhãn dự đoán (Binary Classification)\n","# Score <= Threshold -> ID (0)\n","# Score > Threshold -> OOD (1)\n","def get_preds(scores, is_ood):\n","    y_true = np.ones_like(scores) if is_ood else np.zeros_like(scores)\n","    y_pred = (scores > threshold).astype(int)\n","    return y_true, y_pred\n","\n","# Tổng hợp kết quả\n","y_true_id, y_pred_id = get_preds(id_test_scores, is_ood=False)\n","y_true_near, y_pred_near = get_preds(near_ood_scores, is_ood=True)\n","y_true_far, y_pred_far = get_preds(far_ood_scores, is_ood=True)\n","\n","# Gộp toàn bộ\n","y_true_total = np.concatenate([y_true_id, y_true_near, y_true_far])\n","y_pred_total = np.concatenate([y_pred_id, y_pred_near, y_pred_far])\n","\n","# 4. Tạo Bảng Báo Cáo\n","report = classification_report(y_true_total, y_pred_total, target_names=['ID (Chó/Mèo)', 'OOD (Vật lạ)'], output_dict=True)\n","\n","def fmt(val): return f\"{val:.2%}\"\n","\n","data_report = [\n","    ['In-Distribution (ID)', fmt(report['ID (Chó/Mèo)']['precision']), fmt(report['ID (Chó/Mèo)']['recall']), fmt(report['ID (Chó/Mèo)']['f1-score']), int(report['ID (Chó/Mèo)']['support'])],\n","    ['Out-of-Distribution (OOD)', fmt(report['OOD (Vật lạ)']['precision']), fmt(report['OOD (Vật lạ)']['recall']), fmt(report['OOD (Vật lạ)']['f1-score']), int(report['OOD (Vật lạ)']['support'])],\n","    ['Trung bình (Macro Avg)', fmt(report['macro avg']['precision']), fmt(report['macro avg']['recall']), fmt(report['macro avg']['f1-score']), int(report['macro avg']['support'])],\n","    ['Bình quân (Weighted Avg)', fmt(report['weighted avg']['precision']), fmt(report['weighted avg']['recall']), fmt(report['weighted avg']['f1-score']), int(report['weighted avg']['support'])],\n","    ['Độ chính xác (Accuracy)', '-', '-', fmt(report['accuracy']), int(report['macro avg']['support'])]\n","]\n","\n","df = pd.DataFrame(data_report, columns=['Loại dữ liệu', 'Precision', 'Recall', 'F1-score', 'Số bản ghi'])\n","\n","print(\"\\n\" + \"=\"*30 + \" KẾT QUẢ ĐÁNH GIÁ \" + \"=\"*30)\n","display(df)"]},{"cell_type":"code","execution_count":4,"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":591,"referenced_widgets":["5eaeddec97cc47618272d57b06abd840","bebf2142a78240a2a5db1a7cbe151afb","c1561915ec6f42a3b1750c56414b43aa","815a6b84ebb143fa99d2c21bf1b228db","417b890cc5904114a2faae66867c0f75","807ead10801a45c08f5cee9b63fe3f73","b4c5eeeca20f43c2aa1792b64a09b487","1054a60e58554d6fa854e063e4123bd2","6642aa4a90b449aebe6d0344810eb854","0dd63da7e3344415a9d9a9d40f35900f","a706301d912e4586a1437f1590971931","4ca5727c9dc0451a9960e412a0604465","93c9fd9ddc0b4a348aebe5a13116aefb","812030ed98944bf68f76d43d63ea017d","d214c7187ebe4ed99eebe3ab91aa40bf","5de9dea5a0bc43bf89756b077c93241d","39da05bcd11a448089abe2b5ab733875","8683a6bba5f645c79a82258c587407bc","6415d426aaef41e493cded02a07c0c53","acaf2ba0421943b4afc65e408c8467ed","a6b52c3ad4f34f1e81d83a6d6b95260c","3da6d212e35b41bc9309146df14e0f16"]},"id":"IKS5CLvhZIcZ","executionInfo":{"status":"ok","timestamp":1766717232495,"user_tz":-420,"elapsed":109491,"user":{"displayName":"Nguyễn Đức Hải","userId":"04620552729951256591"}},"outputId":"5024af35-20f5-4a97-d791-f5da44a4d9c5"},"outputs":[{"output_type":"stream","name":"stdout","text":[">>> KHỞI TẠO MÔI TRƯỜNG & TẢI DỮ LIỆU TEST...\n","Drive already mounted at /content/drive; to attempt to forcibly remount, call drive.mount(\"/content/drive\", force_remount=True).\n","\n",">>> 1. ĐANG ĐÁNH GIÁ MODEL OE...\n"]},{"output_type":"display_data","data":{"text/plain":["Scoring ID:   0%|          | 0/58 [00:00<?, ?it/s]"],"application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"5eaeddec97cc47618272d57b06abd840"}},"metadata":{}},{"output_type":"display_data","data":{"text/plain":["Scoring OOD:   0%|          | 0/507 [00:00<?, ?it/s]"],"appli