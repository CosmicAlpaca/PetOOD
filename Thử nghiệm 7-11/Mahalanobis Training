mple.1.running_var\", \"backbone.layer3.0.downsample.1.num_batches_tracked\", \"backbone.layer3.1.conv1.weight\", \"backbone.layer3.1.bn1.weight\", \"backbone.layer3.1.bn1.bias\", \"backbone.layer3.1.bn1.running_mean\", \"backbone.layer3.1.bn1.running_var\", \"backbone.layer3.1.bn1.num_batches_tracked\", \"backbone.layer3.1.conv2.weight\", \"backbone.layer3.1.bn2.weight\", \"backbone.layer3.1.bn2.bias\", \"backbone.layer3.1.bn2.running_mean\", \"backbone.layer3.1.bn2.running_var\", \"backbone.layer3.1.bn2.num_batches_tracked\", \"backbone.layer4.0.conv1.weight\", \"backbone.layer4.0.bn1.weight\", \"backbone.layer4.0.bn1.bias\", \"backbone.layer4.0.bn1.running_mean\", \"backbone.layer4.0.bn1.running_var\", \"backbone.layer4.0.bn1.num_batches_tracked\", \"backbone.layer4.0.conv2.weight\", \"backbone.layer4.0.bn2.weight\", \"backbone.layer4.0.bn2.bias\", \"backbone.layer4.0.bn2.running_mean\", \"backbone.layer4.0.bn2.running_var\", \"backbone.layer4.0.bn2.num_batches_tracked\", \"backbone.layer4.0.downsample.0.weight\", \"backbone.layer4.0.downsample.1.weight\", \"backbone.layer4.0.downsample.1.bias\", \"backbone.layer4.0.downsample.1.running_mean\", \"backbone.layer4.0.downsample.1.running_var\", \"backbone.layer4.0.downsample.1.num_batches_tracked\", \"backbone.layer4.1.conv1.weight\", \"backbone.layer4.1.bn1.weight\", \"backbone.layer4.1.bn1.bias\", \"backbone.layer4.1.bn1.running_mean\", \"backbone.layer4.1.bn1.running_var\", \"backbone.layer4.1.bn1.num_batches_tracked\", \"backbone.layer4.1.conv2.weight\", \"backbone.layer4.1.bn2.weight\", \"backbone.layer4.1.bn2.bias\", \"backbone.layer4.1.bn2.running_mean\", \"backbone.layer4.1.bn2.running_var\", \"backbone.layer4.1.bn2.num_batches_tracked\", \"classifier.weight\", \"classifier.bias\". \n"]}],"source":["# ==============================================================================\n","# SCRIPT ĐÁNH GIÁ: FIX LỖI LOAD MAHALANOBIS (SỬ DỤNG SAVED PARAMS)\n","# ==============================================================================\n","print(\">>> KHỞI TẠO MÔI TRƯỜNG & TẢI DỮ LIỆU TEST...\")\n","!pip install -q pandas scikit-learn torchmetrics\n","\n","import os\n","import torch\n","import torch.nn as nn\n","import torch.nn.functional as F\n","import torchvision\n","import torchvision.models as models\n","import torchvision.transforms as transforms\n","from torch.utils.data import DataLoader, Subset, ConcatDataset\n","from tqdm.notebook import tqdm\n","import numpy as np\n","import pandas as pd\n","from sklearn.metrics import classification_report\n","\n","# 1. CẤU HÌNH\n","DEVICE = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n","BATCH_SIZE = 64\n","\n","# ĐƯỜNG DẪN MODEL (Kiểm tra kỹ đường dẫn này trên Drive của bạn)\n","OE_MODEL_PATH = \"/content/drive/MyDrive/Pet_OOD_Experiments/Outlier_Exposure_Anti_Overfit/best_oe_model_anti_overfit.pt\"\n","MAHALANOBIS_PATH = \"/content/drive/MyDrive/Pet_OOD_Experiments/Mahalanobis_Training_V2/best_mahalanobis_model_v2.pt\"\n","\n","try:\n","    from google.colab import drive\n","    drive.mount('/content/drive')\n","except:\n","    print(\"⚠️ Không mount được Drive.\")\n","\n","# 2. DATASETS (CHỈ CẦN TEST SETS)\n","transform = transforms.Compose([\n","    transforms.Grayscale(num_output_channels=3),\n","    transforms.Resize(256), transforms.CenterCrop(224),\n","    transforms.ToTensor(),\n","    transforms.Normalize([0.485, 0.456, 0.406], [0.229, 0.224, 0.225])\n","])\n","\n","# ID: Oxford Pets\n","id_test = torchvision.datasets.OxfordIIITPet(root='./data', split='test', download=True, transform=transform)\n","num_classes = len(id_test.classes) # 37 class\n","\n","# OOD: STL-10 & SVHN\n","ood_stl = torchvision.datasets.STL10(root='./data', split='test', download=True, transform=transform)\n","idx_stl = [i for i, l in enumerate(ood_stl.labels) if l not in [3, 5]]\n","ood_stl = Subset(ood_stl, idx_stl)\n","ood_svhn = torchvision.datasets.SVHN(root='./data', split='test', download=True, transform=transform)\n","\n","# Gộp OOD\n","ood_test_all = ConcatDataset([ood_stl, ood_svhn])\n","\n","# Loaders\n","loader_id = DataLoader(id_test, batch_size=BATCH_SIZE, shuffle=False, num_workers=2)\n","loader_ood = DataLoader(ood_test_all, batch_size=BATCH_SIZE, shuffle=False, num_workers=2)\n","\n","# ==============================================================================\n","# HÀM HIỂN THỊ BẢNG KẾT QUẢ\n","# ==============================================================================\n","def display_result_table(y_true, y_pred, model_name):\n","    report = classification_report(y_true, y_pred, target_names=['In-Distribution (ID)', 'Out-of-Distribution (OOD)'], output_dict=True)\n","    def fmt(v): return f\"{v:.2%}\"\n","\n","    data = [\n","        ['In-Distribution (ID)', fmt(report['In-Distribution (ID)']['precision']), fmt(report['In-Distribution (ID)']['recall']), fmt(report['In-Distribution (ID)']['f1-score']), report['In-Distribution (ID)']['support']],\n","        ['Out-of-Distribution (OOD)', fmt(report['Out-of-Distribution (OOD)']['precision']), fmt(report['Out-of-Distribution (OOD)']['recall']), fmt(report['Out-of-Distribution (OOD)']['f1-score']), report['Out-of-Distribution (OOD)']['support']],\n","        ['Trung bình vĩ mô', fmt(report['macro avg']['precision']), fmt(report['macro avg']['recall']), fmt(report['macro avg']['f1-score']), report['macro avg']['support']],\n","        ['Bình quân gia quyền', fmt(report['weighted avg']['precision']), fmt(report['weighted avg']['recall']), fmt(report['weighted avg']['f1-score']), report['weighted avg']['support']],\n","        ['Độ chính xác (Accuracy)', '-', '-', fmt(report['accuracy']), report['macro avg']['support']]\n","    ]\n","    df = pd.DataFrame(data, columns=['Loại dữ liệu', 'Precision', 'Recall', 'F1-score', 'Số bản ghi'])\n","    print(f\"\\n{'='*15} KẾT QUẢ: {model_name} {'='*15}\")\n","    display(df)\n","\n","# ==============================================================================\n","# PHẦN 1: ĐÁNH GIÁ OUTLIER EXPOSURE (OE)\n","# ==============================================================================\n","print(\"\\n>>> 1. ĐANG ĐÁNH GIÁ MODEL OE...\")\n","if os.path.exists(OE_MODEL_PATH):\n","    # Khởi tạo model architecture\n","    model_oe = models.resnet18(weights=None)\n","    model_oe.fc = nn.Linear(512, num_classes)\n","\n","    try:\n","        # Load weights (Cố gắng xử lý cả trường hợp save dict hoặc save weight)\n","        checkpoint = torch.load(OE_MODEL_PATH, map_location=DEVICE)\n","        if isinstance(checkpoint, dict) and 'model_state_dict' in checkpoint:\n","            model_oe.load_state_dict(checkpoint['model_state_dict'])\n","        else:\n","            model_oe.load_state_dict(checkpoint)\n","\n","        model_oe.to(DEVICE).eval()\n","\n","        # Tính điểm (Max Softmax Probability - Baseline chuẩn của OE)\n","        scores_id, scores_ood = [], []\n","        with torch.no_grad():\n","            for x, _ in tqdm(loader_id, desc=\"Scoring ID\", leave=False):\n","                probs = F.softmax(model_oe(x.to(DEVICE)), dim=1)\n","                scores_id.extend((1 - probs.max(1)[0]).cpu().numpy()) # 1 - MaxProb\n","            for x, _ in tqdm(loader_ood, desc=\"Scoring OOD\", leave=False):\n","                probs = F.softmax(model_oe(x.to(DEVICE)), dim=1)\n","                scores_ood.extend((1 - probs.max(1)[0]).cpu().numpy())\n","\n","        # Threshold 95% TPR\n","        thresh = np.percentile(scores_id, 95)\n","        y_pred = np.concatenate([(np.array(scores_id) > thresh).astype(int), (np.array(scores_ood) > thresh).astype(int)])\n","        y_true = np.concatenate([np.zeros(len(scores_id)), np.ones(len(scores_ood))])\n","\n","        display_result_table(y_true, y_pred, \"OUTLIER EXPOSURE (OE)\")\n","\n","    except Exception as e:\n","        print(f\"❌ Lỗi OE: {e}\")\n","else:\n","    print(\"❌ Không tìm thấy file OE.\")\n","\n","# ==============================================================================\n","# PHẦN 2: ĐÁNH GIÁ MAHALANOBIS (FIX LỖI)\n","# ==============================================================================\n","print(\"\\n>>> 2. ĐANG ĐÁNH GIÁ MODEL MAHALANOBIS...\")\n","if os.path.exists(MAHALANOBIS_PATH):\n","    # Model architecture\n","    model_maha = models.resnet18(weights=None)\n","    model_maha.fc = nn.Linear(512, num_classes)\n","\n","    # Wrapper để lấy feature từ lớp áp chót\n","    class FeatureExtractor(nn.Module):\n","        def __init__(self, m): super().__init__(); self.m = m\n","        def forward(self, x):\n","            x = self.m.conv1(x); x = self.m.bn1(x); x = self.m.relu(x); x = self.m.maxpool(x)\n","            x = self.m.layer1(x); x = self.m.layer2(x); x = self.m.layer3(x); x = self.m.layer4(x)\n","            x = self.m.avgpool(x); return torch.flatten(x, 1)\n","\n","    try:\n","        # --- FIX LỖI TẠI ĐÂY ---\n","        print(f\"-> Loading checkpoint từ {MAHALANOBIS_PATH}\")\n","        checkpoint = torch.load(MAHALANOBIS_PATH, map_location=DEVICE)\n","\n","        # 1. Load Model Weights\n","        if 'model_state_dict' in checkpoint:\n","            print(\"-> Phát hiện Dictionary Checkpoint. Loading model_state_dict...\")\n","            model_maha.load_state_dict(checkpoint['model_state_dict'])\n","        else:\n","            print(\"-> Loading direct state_dict...\")\n","            model_maha.load_state_dict(checkpoint)\n","\n","        model_maha.to(DEVICE).eval()\n","        extractor = FeatureExtractor(model_maha)\n","\n","        # 2. Load Mahalanobis Parameters (KHÔNG CẦN TÍNH LẠI)\n","        if 'class_means' in checkpoint and 'shared_precision' in checkpoint:\n","            print(\"✅ Đã tìm thấy tham số Mahalanobis (Means & Precision) trong file!\")\n","            means = checkpoint['class_means'].to(DEVICE)\n","            prec = checkpoint['shared_precision'].to(DEVICE)\n","        else:\n","            raise ValueError(\"File model không chứa 'class_means' hoặc 'shared_precision'. Cần file checkpoint đầy đủ.\")\n","\n","        # 3. Hàm tính điểm Mahalanobis\n","        def get_maha_scores(loader):\n","            s_list = []\n","            with torch.no_grad():\n","                for x, _ in tqdm(loader, desc=\"Maha Scoring\", leave=False):\n","                    f = extractor(x.to(DEVICE)) # [B, 512]\n","                    # Tính khoảng cách tới từng class\n","                    batch_dists = []\n","                    for c in range(num_classes):\n","                        # (x - mu)\n","                        diff = f - means[c].unsqueeze(0)\n","                        # (x-mu)^T * Sigma^-1 * (x-mu)\n","                        # Tối ưu hóa: sum( (diff @ prec) * diff )\n","                        term = torch.matmul(diff, prec)\n","                        dist = torch.sum(term * diff, dim=1)\n","                        batch_dists.append(dist)\n","\n","                    # Lấy khoảng cách nhỏ nhất (Class gần nhất)\n","                    min_dist, _ = torch.min(torch.stack(batch_dists, 1), 1)\n","                    s_list.extend(min_dist.cpu().numpy())\n","            return np.array(s_list)\n","\n","        # 4. Thực thi\n","        id_scores = get_maha_scores(loader_id)\n","        ood_scores = get_maha_scores(loader_ood)\n","\n","        # Threshold\n","        thresh = np.percentile(id_scores, 95)\n","\n","        y_pred = np.concatenate([(id_scores > thresh).astype(int), (ood_scores > thresh).astype(int)])\n","        y_true = np.concatenate([np.zeros(len(id_scores)), np.ones(len(ood_scores))])\n","\n","        display_result_table(y_true, y_pred, \"MAHALANOBIS DISTANCE\")\n","\n","    except Exception as e:\n","        print(f\"❌ Vẫn lỗi Mahalanobis: {e}\")\n","        import traceback\n","        traceback.print_exc()\n","else:\n","    print(\"❌ Không tìm thấy file Mahalanobis.\")"]}],"metadata":{"accelerator":"GPU","colab":{"gpuType":"T4","provenance":[],"mount_file_id":"1fjPETEfO3EnHJdeAyk-wDmAlnm34qDLV","authors